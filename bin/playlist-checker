#!/bin/sh
# Start TV & Radio Playlist Checker.
# Uses the system Python first; if that one has no Tk (for example when another
# Python version was made the default), any other installed Python 3 with Tk.
APP=/usr/share/playlist-checker/playlist_checker_gui.py

for py in /usr/bin/python3 python3 python3.14 python3.13 python3.12 python3.11 python3.10 python3.9; do
    if command -v "$py" >/dev/null 2>&1 && "$py" -c "import tkinter" >/dev/null 2>&1; then
        exec "$py" -B "$APP" "$@"
    fi
done

msg="Python with Tk (tkinter) was not found.
Install it with:  sudo apt install python3-tk"
echo "playlist-checker: $msg" >&2
if [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && command -v notify-send >/dev/null 2>&1; then
    notify-send -i playlist-checker "TV & Radio Playlist Checker" "$msg"
fi
exit 1
